# ResearchAtlas Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=researchatlas

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# Default Admin Account
# ============================================
# These credentials are used to create the initial admin account
# The admin is created only if no admin exists in the database
DEFAULT_ADMIN_EMAIL=admin@raisoni.net
DEFAULT_ADMIN_PASSWORD=Admin@123

# ============================================
# Email Domain Restrictions
# ============================================
# Admin and Faculty must use @raisoni.net
# Students must use @ghrce.raisoni.net
ADMIN_EMAIL_DOMAIN=raisoni.net
FACULTY_EMAIL_DOMAIN=raisoni.net
STUDENT_EMAIL_DOMAIN=ghrce.raisoni.net

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Application Settings
# ============================================
APP_NAME=ResearchAtlas
DEBUG=true

# ============================================
# API Credentials (Optional - for Phase 6+)
# ============================================
# ORCID API (Public API is free, no credentials required for basic access)
# For member API access, register at: https://orcid.org/develop
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Scopus API (Requires institutional access)
# Register at: https://dev.elsevier.com/
SCOPUS_API_KEY=

# Web of Science API (Requires institutional access)
# Contact Clarivate for API access
WOS_API_KEY=

# Google Scholar (No official API - uses scraping libraries)
# No API key required

# OpenAlex API (Free and open)
# Register for polite use: https://openalex.org/
OPENALEX_EMAIL=
